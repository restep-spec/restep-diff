{
  "description": "Pares de descubrimientos: el viejo es base.json con el parche «old» (JSON Merge Patch, RFC 7396) y el nuevo es el viejo con el parche «new». «expect» son exactamente las reglas que deben salir. La fecha es la de «date» o, si falta, 2026-11-20T00:00:00Z.",
  "cases": [
    { "name": "sin cambios", "new": {}, "expect": [] },
    { "name": "miembros x- ignorados", "old": { "x-build": "1" }, "new": { "x-build": "2", "collections": { "books": { "x-team": "catálogo" } } }, "expect": [] },
    { "name": "plantilla con otra variable", "new": { "collections": { "reviews": { "path": "/books/{book}/reviews" } } }, "expect": [] },

    { "name": "restep 1.0 → 1.1", "new": { "restep": "1.1" }, "expect": ["restep.minor-up", "restep.experimental"] },
    { "name": "restep 1.1 → 1.0", "old": { "restep": "1.1" }, "new": { "restep": "1.0" }, "expect": ["restep.minor-down", "restep.experimental"] },
    { "name": "restep 1 → 2", "new": { "restep": "2.0" }, "expect": ["restep.major"] },
    { "name": "versión de la API", "new": { "version": "2" }, "expect": ["version.changed"] },

    { "name": "perfil nuevo", "old": { "profiles": ["core", "query", "writes", "sync"] }, "new": { "profiles": ["core", "query", "writes", "relations", "sync"] }, "expect": ["profile.added"] },
    { "name": "perfil quitado", "new": { "profiles": ["core", "query", "relations", "sync"] }, "expect": ["profile.removed"] },
    { "name": "core implícito", "new": { "profiles": ["query", "writes", "relations", "sync"] }, "expect": [] },
    { "name": "extensión nueva", "new": { "extensions": ["actions", "batch", "filter-expr"] }, "expect": ["extension.added"] },
    { "name": "extensión quitada", "new": { "extensions": ["batch"] }, "expect": ["extension.removed"] },

    { "name": "batch.path", "new": { "batch": { "path": "/lotes" } }, "expect": ["batch.path"] },
    { "name": "max_operations baja", "new": { "batch": { "max_operations": 10 } }, "expect": ["batch.max-operations.lower"] },
    { "name": "max_operations sube", "new": { "batch": { "max_operations": 50 } }, "expect": ["batch.max-operations.higher"] },
    { "name": "idempotency.ttl sube", "new": { "idempotency": { "ttl": 172800 } }, "expect": ["idempotency.ttl-higher"] },
    { "name": "events nuevo", "old": { "events": null }, "new": { "events": "/events" }, "expect": ["events.added"] },
    { "name": "events cambia", "new": { "events": "/eventos" }, "expect": ["events.changed"] },
    { "name": "events desaparece", "new": { "events": null }, "expect": ["events.changed"] },
    { "name": "status", "new": { "status": "/estado" }, "expect": ["status.changed"] },
    { "name": "miembro desconocido de la raíz", "old": { "pricing": "free" }, "new": { "pricing": "paid" }, "expect": ["member.changed"] },
    { "name": "miembro desconocido de una colección", "new": { "collections": { "books": { "shelf": "A" } } }, "expect": ["member.changed"] },

    { "name": "colección nueva", "new": { "collections": { "shelves": { "path": "/shelves" } } }, "expect": ["collection.added"] },
    { "name": "colección quitada", "new": { "collections": { "categories": null } }, "expect": ["collection.removed"] },
    { "name": "path de colección", "new": { "collections": { "authors": { "path": "/writers" } } }, "expect": ["collection.path"] },
    { "name": "descripción", "new": { "collections": { "books": { "description": "Libros a la venta." } } }, "expect": ["description.changed"] },
    { "name": "descripción de una acción", "new": { "collections": { "books": { "actions": { "reserve": { "description": "Reserva un ejemplar." } } } } }, "expect": ["description.changed"] },

    { "name": "método nuevo", "new": { "collections": { "authors": { "methods": ["GET", "POST"] } } }, "expect": ["method.added"] },
    { "name": "método quitado", "new": { "collections": { "books": { "item_methods": ["GET", "PATCH"] } } }, "expect": ["method.removed"] },
    { "name": "methods declarado", "new": { "collections": { "reviews": { "methods": ["GET"] } } }, "expect": ["methods.declared"] },
    { "name": "methods sin declarar", "new": { "collections": { "authors": { "methods": null } } }, "expect": ["methods.undeclared"] },

    { "name": "esquema nuevo", "new": { "collections": { "categories": { "schemas": { "item": { "type": "object" } } } } }, "expect": ["schema.added"] },
    { "name": "esquema quitado", "new": { "collections": { "products": { "schemas": { "update": null } } } }, "expect": ["schema.removed"] },
    { "name": "enlace a esquema", "new": { "collections": { "books": { "schemas": { "update": "/schemas/book-update-2.json" } } } }, "expect": ["schema.link"] },
    { "name": "enlace igual", "new": { "collections": { "books": { "schemas": { "update": "/schemas/book-update.json" } } } }, "expect": [] },

    { "name": "campo nuevo", "new": { "collections": { "books": { "schemas": { "item": { "properties": { "year": { "type": "integer" } } } } } } }, "expect": ["field.added"] },
    { "name": "campo quitado", "new": { "collections": { "books": { "schemas": { "item": { "properties": { "rating": null } } } } } }, "expect": ["field.removed"] },
    { "name": "tipo de campo", "new": { "collections": { "books": { "schemas": { "item": { "properties": { "rating": { "anyOf": [{ "type": "string" }, { "type": "null" }] } } } } } } }, "expect": ["field.type"] },
    { "name": "campo deja de venir siempre", "new": { "collections": { "books": { "schemas": { "item": { "required": ["id", "title"] } } } } }, "expect": ["field.optional"] },
    { "name": "enum de salida", "new": { "collections": { "books": { "schemas": { "item": { "properties": { "category": { "enum": ["novela-negra", "ensayo"] } } } } } } }, "expect": ["field.enum-added", "field.enum-removed"] },

    { "name": "entrada opcional nueva", "new": { "collections": { "books": { "schemas": { "create": { "properties": { "year": { "type": "integer" } } } } } } }, "expect": ["input.added-optional"] },
    { "name": "entrada obligatoria nueva", "new": { "collections": { "books": { "schemas": { "create": { "required": ["title", "price", "year"], "properties": { "year": { "type": "integer" } } } } } } }, "expect": ["input.added-required"] },
    { "name": "entrada pasa a obligatoria", "new": { "collections": { "books": { "schemas": { "create": { "required": ["title", "price", "rating"] } } } } }, "expect": ["input.now-required"] },
    { "name": "default nuevo en create", "new": { "collections": { "books": { "schemas": { "create": { "properties": { "category": { "default": "poesia" } } } } } } }, "expect": ["input.default-added"] },
    { "name": "default cambiado en create", "old": { "collections": { "books": { "schemas": { "create": { "properties": { "category": { "default": "poesia" } } } } } } }, "new": { "collections": { "books": { "schemas": { "create": { "properties": { "category": { "default": "novela-negra" } } } } } } }, "expect": ["input.default-changed"] },
    { "name": "default quitado en create", "old": { "collections": { "books": { "schemas": { "create": { "properties": { "category": { "default": "poesia" } } } } } } }, "new": { "collections": { "books": { "schemas": { "create": { "properties": { "category": { "default": null } } } } } } }, "expect": ["input.default-removed"] },
    { "name": "default en update: no significa nada", "old": { "collections": { "books": { "schemas": { "update": { "type": "object", "properties": { "category": { "type": "string" } } } } } } }, "new": { "collections": { "books": { "schemas": { "update": { "properties": { "category": { "default": "poesia" } } } } } } }, "expect": [] },
    { "name": "entrada pasa a opcional", "new": { "collections": { "books": { "schemas": { "create": { "required": ["title"] } } } } }, "expect": ["input.now-optional"] },
    { "name": "entrada quitada", "new": { "collections": { "books": { "schemas": { "create": { "properties": { "rating": null } } } } } }, "expect": ["input.removed"] },
    { "name": "entrada sin null", "new": { "collections": { "books": { "schemas": { "create": { "properties": { "rating": { "anyOf": null, "type": "number" } } } } } } }, "expect": ["input.type-narrowed"] },
    { "name": "entrada admite null", "new": { "collections": { "books": { "schemas": { "create": { "properties": { "title": { "type": ["string", "null"] } } } } } } }, "expect": ["input.type-widened"] },
    { "name": "entrada integer a number", "new": { "collections": { "books": { "actions": { "reserve": { "input": { "properties": { "hours": { "type": "number" } } } } } } } }, "expect": ["input.type-widened"] },
    { "name": "enum de entrada", "new": { "collections": { "books": { "schemas": { "create": { "properties": { "category": { "enum": ["novela-negra", "ensayo"] } } } } } } }, "expect": ["input.enum-added", "input.enum-removed"] },
    { "name": "enum de entrada nuevo", "new": { "collections": { "books": { "schemas": { "create": { "properties": { "rating": { "anyOf": null, "enum": [1, 2, 3, 4, 5, null] } } } } } } }, "expect": ["input.constraint-tightened", "input.type-narrowed"] },
    { "name": "maxLength baja", "new": { "collections": { "books": { "schemas": { "create": { "properties": { "title": { "maxLength": 100 } } } } } } }, "expect": ["input.constraint-tightened"] },
    { "name": "maxLength sube", "new": { "collections": { "books": { "schemas": { "create": { "properties": { "title": { "maxLength": 300 } } } } } } }, "expect": ["input.constraint-relaxed"] },
    { "name": "pattern cambia", "new": { "collections": { "books": { "schemas": { "create": { "properties": { "price": { "pattern": "^[0-9]+\\.[0-9]{2}$" } } } } } } }, "expect": ["input.constraint-tightened"] },
    { "name": "input de acción más estricto", "new": { "collections": { "books": { "actions": { "reserve": { "input": { "properties": { "hours": { "maximum": 24 } } } } } } } }, "expect": ["input.constraint-tightened"] },
    { "name": "cuerpo cerrado", "new": { "collections": { "products": { "schemas": { "update": { "additionalProperties": false } } } } }, "expect": ["input.closed"] },
    { "name": "cuerpo abierto", "new": { "collections": { "books": { "schemas": { "create": { "additionalProperties": null } } } } }, "expect": ["input.opened"] },

    { "name": "filtro nuevo", "new": { "collections": { "books": { "filter": { "year": { "type": "integer", "ops": ["eq"] } } } } }, "expect": ["filter.added"] },
    { "name": "filtro quitado", "new": { "collections": { "books": { "filter": { "rating": null } } } }, "expect": ["filter.removed"] },
    { "name": "operador nuevo", "new": { "collections": { "books": { "filter": { "rating": { "ops": ["ge", "le", "null"] } } } } }, "expect": ["filter.op-added"] },
    { "name": "operador quitado", "new": { "collections": { "books": { "filter": { "price": { "ops": ["eq"] } } } } }, "expect": ["filter.op-removed"] },
    { "name": "tipo de filtro", "new": { "collections": { "books": { "filter": { "price": { "type": "number" } } } } }, "expect": ["filter.type"] },
    { "name": "valores de filtro", "new": { "collections": { "books": { "filter": { "category": { "values": ["novela-negra", "ensayo"] } } } } }, "expect": ["filter.values-added", "filter.values-removed"] },
    { "name": "filtro con nombre nuevo", "new": { "collections": { "books": { "named_filters": { "featured": { "description": "Destacados." } } } } }, "expect": ["named-filter.added"] },
    { "name": "filtro con nombre quitado", "old": { "collections": { "books": { "named_filters": { "featured": { "description": "Destacados." } } } } }, "new": { "collections": { "books": { "named_filters": { "featured": null } } } }, "expect": ["named-filter.removed"] },
    { "name": "filtro con nombre que pasa a interruptor", "old": { "collections": { "books": { "named_filters": { "search": { "type": "string", "description": "Título." } } } } }, "new": { "collections": { "books": { "named_filters": { "search": { "type": null } } } } }, "expect": ["named-filter.type"] },
    { "name": "valores de un filtro con nombre", "old": { "collections": { "books": { "named_filters": { "shelf": { "type": "enum", "values": ["a", "b"], "description": "Estante." } } } } }, "new": { "collections": { "books": { "named_filters": { "shelf": { "values": ["a", "c"] } } } } }, "expect": ["named-filter.values-added", "named-filter.values-removed"] },
    { "name": "descripción de un filtro con nombre", "old": { "collections": { "books": { "named_filters": { "featured": { "description": "Destacados." } } } } }, "new": { "collections": { "books": { "named_filters": { "featured": { "description": "Destacados del mes." } } } } }, "expect": ["named-filter.description"] },

    { "name": "orden nuevo", "new": { "collections": { "books": { "sort": ["id", "price", "rating", "title", "year"] } } }, "expect": ["sort.added"] },
    { "name": "orden quitado", "new": { "collections": { "books": { "sort": ["id", "price", "title"] } } }, "expect": ["sort.removed"] },
    { "name": "max_limit baja", "new": { "collections": { "books": { "max_limit": 20 } } }, "expect": ["max-limit.lower"] },
    { "name": "max_limit sube", "new": { "collections": { "books": { "max_limit": 100 } } }, "expect": ["max-limit.higher"] },
    { "name": "max_limit sin declarar", "new": { "collections": { "reviews": { "max_limit": null } } }, "expect": ["max-limit.removed"] },
    { "name": "count nuevo", "new": { "collections": { "reviews": { "count": "exact" } } }, "expect": ["count.added"] },
    { "name": "count quitado", "new": { "collections": { "books": { "count": null } } }, "expect": ["count.removed"] },
    { "name": "count exacto a estimado", "old": { "collections": { "books": { "count": "exact" } } }, "new": { "collections": { "books": { "count": "estimated" } } }, "expect": ["count.estimated"] },
    { "name": "count estimado a exacto", "new": { "collections": { "books": { "count": "exact" } } }, "expect": ["count.exact"] },

    { "name": "relación nueva", "new": { "collections": { "books": { "relations": { "publisher": { "to": "publishers" } } } } }, "expect": ["relation.added"] },
    { "name": "relación quitada", "new": { "collections": { "books": { "relations": { "author": null } } } }, "expect": ["relation.removed"] },
    { "name": "destino de relación", "new": { "collections": { "products": { "relations": { "category": { "to": ["categories", "tags"] } } } } }, "expect": ["relation.to"] },
    { "name": "relación a muchos", "new": { "collections": { "categories": { "relations": { "parent": { "many": true } } } } }, "expect": ["relation.many"] },
    { "name": "relación expandible", "new": { "collections": { "books": { "relations": { "reviews": { "include": true } } } } }, "expect": ["relation.include-added"] },
    { "name": "relación no expandible", "new": { "collections": { "books": { "relations": { "author": { "include": false } } } } }, "expect": ["relation.include-removed"] },
    { "name": "path de relación", "new": { "collections": { "books": { "relations": { "reviews": { "path": "/books/{id}/opiniones" } } } } }, "expect": ["relation.path"] },
    { "name": "include_depth baja", "new": { "collections": { "books": { "include_depth": null } } }, "expect": ["include-depth.lower"] },
    { "name": "include_depth sube", "new": { "collections": { "books": { "include_depth": 3 } } }, "expect": ["include-depth.higher"] },

    { "name": "sync nuevo", "new": { "collections": { "authors": { "sync": {} } } }, "expect": ["sync.added"] },
    { "name": "sync quitado", "new": { "collections": { "books": { "sync": null } } }, "expect": ["sync.removed"] },
    { "name": "sync.retention por debajo de 7 días", "new": { "collections": { "books": { "sync": { "retention": 86400 } } } }, "expect": ["sync.retention-too-low"] },

    { "name": "acción nueva", "new": { "collections": { "books": { "actions": { "import": { "on": "collection", "safe": false, "idempotent": false } } } } }, "expect": ["action.added"] },
    { "name": "acción quitada", "new": { "collections": { "books": { "actions": { "preview": null } } } }, "expect": ["action.removed"] },
    { "name": "acción de colección", "new": { "collections": { "books": { "actions": { "reserve": { "on": "collection" } } } } }, "expect": ["action.on"] },
    { "name": "acción con otro método", "new": { "collections": { "books": { "actions": { "preview": { "method": null } } } } }, "expect": ["action.method"] },
    { "name": "acción deja de ser idempotente", "new": { "collections": { "books": { "actions": { "reserve": { "idempotent": false } } } } }, "expect": ["action.weaker"] },
    { "name": "acción pasa a ser segura", "new": { "collections": { "books": { "actions": { "reserve": { "safe": true } } } } }, "expect": ["action.stronger"] },

    { "name": "mapa de idioma nuevo", "new": { "collections": { "products": { "language_maps": { "description": {} } } } }, "expect": ["language-map.added"] },
    { "name": "campo que pasa a mapa", "new": { "collections": { "products": { "language_maps": { "price": {} } } } }, "expect": ["language-map.retyped"] },
    { "name": "mapa que deja de serlo", "new": { "collections": { "products": { "language_maps": { "name": null } } } }, "expect": ["language-map.removed"] },

    { "name": "herencia de un dato nuevo", "new": { "collections": { "products": { "inherit": { "discount": { "own": "discount_own", "from": ["category"] } } } } }, "expect": ["inherit.added"] },
    { "name": "herencia de un campo de solo lectura", "old": { "collections": { "products": { "schemas": { "item": { "properties": { "shipping": { "type": "string", "readOnly": true } } } } } } }, "new": { "collections": { "products": { "inherit": { "shipping": { "own": "shipping_own", "from": ["category"] } } } } }, "expect": ["inherit.added"] },
    { "name": "herencia de un campo que se escribía", "new": { "collections": { "products": { "inherit": { "price": { "own": "price_own", "from": ["category"] } } } } }, "expect": ["inherit.writable"] },
    { "name": "herencia sin esquemas", "new": { "collections": { "categories": { "inherit": { "tax_rate": { "own": "tax_rate_own", "from": ["parent"] } } } } }, "expect": ["inherit.unknown"] },
    { "name": "herencia quitada", "new": { "collections": { "products": { "inherit": null } } }, "expect": ["inherit.removed"] },
