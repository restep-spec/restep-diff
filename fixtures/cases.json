    { "name": "sunset cambiado", "old": { "collections": { "books": { "deprecations": [{ "kind": "field", "name": "rating", "sunset": "2027-12-01T00:00:00Z" }] } } }, "new": { "collections": { "books": { "deprecations": [{ "kind": "field", "name": "rating", "sunset": "2028-06-01T00:00:00Z" }] } } }, "expect": ["deprecation.sunset-changed"] },
